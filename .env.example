# Copie este arquivo para .env e preencha.

# Opcional: chave da API do Claude (https://console.anthropic.com).
# Se ficar vazia, o programa usa o Claude Code logado na sua assinatura (comando `claude`).
ANTHROPIC_API_KEY=

# Opcional: token do GitHub (aumenta o limite de buscas nos repositórios de vagas de 60 para 5000/h)
GITHUB_TOKEN=

# Opcional: envio de candidaturas por e-mail (vagas que pedem "envie seu CV para ...").
# Gmail: use uma "senha de app" (https://myaccount.google.com/apppasswords), nunca sua senha normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
